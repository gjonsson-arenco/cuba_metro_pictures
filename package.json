{
  "name": "metro-photos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "dev": "turbo run dev --parallel",
    "clean": "turbo run clean",
    "local:up": "docker start metro-localstack || docker run -d --name metro-localstack -p 4566:4566 -e SERVICES=s3,dynamodb localstack/localstack:3",
    "local:down": "docker stop metro-localstack",
    "local:bootstrap": "pnpm --filter @metro/backend local:bootstrap",
    "local:api": "pnpm --filter @metro/backend local:server",
    "local:web": "pnpm --filter @metro/frontend dev"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
